--cpu Cortex-M3
"button_pro\startup_stm32f103xb.o"
"button_pro\main.o"
"button_pro\stm32f1xx_it.o"
"button_pro\stm32f1xx_hal_msp.o"
"button_pro\stm32f1xx_hal_gpio_ex.o"
"button_pro\stm32f1xx_hal.o"
"button_pro\stm32f1xx_hal_rcc.o"
"button_pro\stm32f1xx_hal_rcc_ex.o"
"button_pro\stm32f1xx_hal_gpio.o"
"button_pro\stm32f1xx_hal_dma.o"
"button_pro\stm32f1xx_hal_cortex.o"
"button_pro\stm32f1xx_hal_pwr.o"
"button_pro\stm32f1xx_hal_flash.o"
"button_pro\stm32f1xx_hal_flash_ex.o"
"button_pro\stm32f1xx_hal_exti.o"
"button_pro\system_stm32f1xx.o"
--strict --scatter "button_pro\button_pro.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "button_pro.map" -o button_pro\button_pro.axf